# Lumina Parent Connect — Environment Configuration Template
# For local prototype demo mode, no live API keys are required.
# If connecting to Firebase Authentication / Cloud Firestore in production, populate the variables below:

VITE_APP_TITLE="Lumina Parent Connect"
VITE_COLLEGE_NAME="Meenakshi Sundararajan Engineering College"
VITE_ENABLE_MOCK_DATA="true"

# Optional Firebase Configuration (Production integration)
VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="msec-parent-connect.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="msec-parent-connect"
VITE_FIREBASE_STORAGE_BUCKET="msec-parent-connect.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
